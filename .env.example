# Public operator contact used for API etiquette and Unpaywall requests.
CONTACT_EMAIL=research-api@ogleits.com

# Optional. NCBI works without a key at a lower rate limit.
NCBI_API_KEY=

# Required only by the Cloudflare Worker. Create a GitHub OAuth App whose
# callback is https://<your-worker>/callback, then store these with Wrangler.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required only by the Cloudflare Worker. Use at least 32 random characters.
COOKIE_ENCRYPTION_KEY=

# Optional comma-separated custom hostnames for a Cloudflare custom domain.
ALLOWED_HOSTNAMES=
ALLOWED_ORIGIN_HOSTNAMES=
