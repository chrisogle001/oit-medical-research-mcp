{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oit-medical-research-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "CONTACT_EMAIL": "research-api@ogleits.com"
  }
}
