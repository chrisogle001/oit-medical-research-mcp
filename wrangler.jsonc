{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oit-medical-research-mcp",
  "main": "apps/cloudflare/src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "vars": {
    "CONTACT_EMAIL": "research-api@ogleits.com",
    "ALLOWED_HOSTNAMES": "",
    "ALLOWED_ORIGIN_HOSTNAMES": ""
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    },
    {
      "binding": "USER_DATA_KV"
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_ACCOUNT_RATE_LIMITER",
      "namespace_id": "48101",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "USAGE_ANALYTICS",
      "dataset": "oit_medical_research_usage"
    }
  ]
}
