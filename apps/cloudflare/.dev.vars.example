# Copy this file to .dev.vars for local Worker development.
# Never commit real secrets.
# Optional: only needed for GitHub-backed browser account management.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COOKIE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
USER_DATA_ENCRYPTION_KEY=replace-with-a-different-32-character-random-secret
NCBI_API_KEY=
ALLOWED_HOSTNAMES=
ALLOWED_ORIGIN_HOSTNAMES=
