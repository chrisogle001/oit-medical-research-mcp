{
  "name": "oit-medical-research-mcp",
  "version": "0.8.0",
  "description": "Medical literature and public CMS data MCP server for local and Cloudflare deployments.",
  "type": "module",
  "license": "MIT",
  "author": "Ogle IT Services <research-api@ogleits.com>",
  "homepage": "https://research.chrisogle.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisogle001/oit-medical-research-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/chrisogle001/oit-medical-research-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "medical-research",
    "cms",
    "medicare",
    "medicaid",
    "pubmed",
    "europe-pmc",
    "cloudflare-workers"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "oit-medical-research-mcp": "dist/oit-medical-research-mcp.js"
  },
  "files": [
    "dist/oit-medical-research-mcp.js",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "npm run typecheck && esbuild ./apps/local/src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/oit-medical-research-mcp.js",
    "prepack": "npm run build",
    "package:check": "npm pack --dry-run",
    "release:verify-tag": "tsx scripts/verify-release-tag.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "smoke:failures": "tsx scripts/smoke-failure-modes.ts",
    "smoke:providers": "tsx scripts/smoke-providers.ts",
    "smoke:cms": "tsx scripts/smoke-cms.ts",
    "smoke:cloudflare": "tsx scripts/smoke-cloudflare.ts",
    "smoke:oauth": "tsx scripts/smoke-oauth.ts",
    "smoke:oauth-concurrency": "tsx scripts/smoke-oauth-concurrency.ts",
    "smoke:protocol": "npm run build && tsx scripts/smoke-protocol.ts",
    "start:local": "tsx apps/local/src/index.ts",
    "dev:cloudflare": "wrangler dev --config wrangler.jsonc",
    "dev:cloudflare:staging": "wrangler dev --env staging --config apps/cloudflare/wrangler.production.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:cloudflare": "npm run deploy",
    "deploy:cloudflare:production": "wrangler deploy --env= --config apps/cloudflare/wrangler.production.jsonc",
    "deploy:cloudflare:staging": "wrangler deploy --env staging --config apps/cloudflare/wrangler.production.jsonc",
    "check:cloudflare": "wrangler deploy --dry-run --config wrangler.jsonc",
    "check:cloudflare:production": "wrangler deploy --dry-run --env= --config apps/cloudflare/wrangler.production.jsonc",
    "check:cloudflare:staging": "wrangler deploy --dry-run --env staging --config apps/cloudflare/wrangler.production.jsonc",
    "cf-typegen": "tsx scripts/cloudflare-typegen.ts",
    "cf-typegen:check": "tsx scripts/cloudflare-typegen.ts --check"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260830.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "cloudflare": {
    "bindings": {
      "COOKIE_ENCRYPTION_KEY": {
        "description": "Generate a random value of at least 32 characters for signed browser sessions."
      },
      "USER_DATA_ENCRYPTION_KEY": {
        "description": "Generate a different random value of at least 32 characters for encrypted personal provider settings."
      }
    }
  }
}
